#!/bin/bash
# gcs-opt wrapper script

# Get the directory where the script is located
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
JAR_PATH="$DIR/build/quarkus-app/quarkus-run.jar"

if [ ! -f "$JAR_PATH" ]; then
    echo "Error: JAR file not found at $JAR_PATH"
    echo "Please run './gradlew quarkusBuild' first."
    exit 1
fi

java -jar "$JAR_PATH" "$@"
